rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function ownsUserDoc(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if signedIn();
      allow create, update, delete: if ownsUserDoc(userId);
    }

    match /habits/{habitId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /completions/{completionId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
      allow write: if signedIn() && request.resource.data.userId == request.auth.uid;
    }
  }
}
